---
/**
 * 页脚覆写:沿 Starlight 默认(编辑链接 / 最近更新 / 上下页),末尾加法律条目行:
 * 服务条款 · 隐私政策(门户既有页)· ICP 备案号(用户给定 2026-09-11,链工信部备案系统,与门户页脚同值同链)· 版权。
 */
import EditLink from '@astrojs/starlight/components/EditLink.astro';
import LastUpdated from '@astrojs/starlight/components/LastUpdated.astro';
import Pagination from '@astrojs/starlight/components/Pagination.astro';
import { uiLocale } from '../lib/categories.mjs';

const STRINGS = {
  'zh-CN': { terms: '服务条款', privacy: '隐私政策', nav: '法律条目', stance: '技术立场', copyright: '站点与文档以 MIT 许可公开。' },
  en: { terms: 'Terms of service', privacy: 'Privacy policy', nav: 'Legal', stance: 'Technical stance', copyright: 'Site and docs are published under the MIT license.' },
  ja: { terms: '利用規約', privacy: 'プライバシーポリシー', nav: '法的情報', stance: '技術上の立場', copyright: 'サイトとドキュメントは MIT ライセンスで公開しています。' },
  ko: { terms: '서비스 약관', privacy: '개인정보 처리방침', nav: '법적 고지', stance: '기술 입장', copyright: '사이트와 문서는 MIT 라이선스로 공개됩니다.' },
} as const;
const locale = uiLocale(Astro.locals.starlightRoute.locale);
const t = STRINGS[locale];
const stanceHref = locale === 'zh-CN' ? '/getting-started/principles/' : `/${locale}/getting-started/principles/`;
const year = new Date().getFullYear();
const legal = [
  { href: 'https://www.tansr.com/terms', label: t.terms },
  { href: 'https://www.tansr.com/privacy', label: t.privacy },
];
/** ICP 备案号(用户给定 2026-09-11;与门户 www.tansr.com 页脚同值),按工信部要求链到备案系统首页 */
const ICP = '浙ICP备2025206744号-4';
const ICP_HREF = 'https://beian.miit.gov.cn/';
---

<footer class="sl-flex">
  <div class="meta sl-flex">
    <EditLink />
    <LastUpdated />
  </div>
  <Pagination />
  <div class="legal">
    <nav aria-label={t.nav} class="legal-links">
      <a href={stanceHref}>{t.stance}</a>
      {legal.map((l) => <a href={l.href} rel="noopener">{l.label}</a>)}
      <a class="icp" lang="zh-CN" href={ICP_HREF} target="_blank" rel="noopener noreferrer">{ICP}</a>
    </nav>
    <p class="copyright">© {year} tansr · {t.copyright}</p>
  </div>
</footer>

<style>
  @layer starlight.core {
    footer {
      flex-direction: column;
      gap: 1.5rem;
    }
    .meta {
      gap: 0.75rem 3rem;
      justify-content: space-between;
      flex-wrap: wrap;
      margin-top: 3rem;
      font-size: var(--sl-text-sm);
      color: var(--sl-color-gray-3);
    }
    .meta > :global(p:only-child) {
      margin-inline-start: auto;
    }
    .legal {
      border-top: 1px solid var(--sl-color-gray-6);
      padding-top: 1rem;
      font-size: var(--sl-text-xs);
      color: var(--sl-color-gray-3);
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
    }
    .legal-links {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem 1.25rem;
      align-items: center;
    }
    .legal-links a {
      color: var(--sl-color-gray-2);
      text-decoration: none;
    }
    .legal-links a:hover {
      color: var(--sl-color-white);
      text-decoration: underline;
    }
    .copyright {
      margin: 0;
    }
  }
</style>
