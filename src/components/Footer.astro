---
/**
 * 页脚覆写:沿 Starlight 默认(编辑链接 / 最近更新 / 上下页),末尾加法律条目行:
 * 服务条款 · 隐私政策(门户既有页)· ICP 备案号(操作者填)· 版权。
 */
import EditLink from '@astrojs/starlight/components/EditLink.astro';
import LastUpdated from '@astrojs/starlight/components/LastUpdated.astro';
import Pagination from '@astrojs/starlight/components/Pagination.astro';
import { uiLocale } from '../lib/categories.mjs';

const STRINGS = {
  'zh-CN': { terms: '服务条款', privacy: '隐私政策', nav: '法律条目', copyright: '站点代码 MIT;文档内容保留所有权利。' },
  en: { terms: 'Terms of service', privacy: 'Privacy policy', nav: 'Legal', copyright: 'Site code MIT; content all rights reserved.' },
  ja: { terms: '利用規約', privacy: 'プライバシーポリシー', nav: '法的情報', copyright: 'サイトのコードは MIT ライセンス。ドキュメントの内容は全著作権を保有します。' },
  ko: { terms: '서비스 약관', privacy: '개인정보 처리방침', nav: '법적 고지', copyright: '사이트 코드는 MIT 라이선스, 문서 내용은 모든 권리 보유.' },
} as const;
const t = STRINGS[uiLocale(Astro.locals.starlightRoute.locale)];
const year = new Date().getFullYear();
const legal = [
  { href: 'https://www.tansr.com/terms', label: t.terms },
  { href: 'https://www.tansr.com/privacy', label: t.privacy },
];
/** 页脚展示文本;门户页脚已有则同值(操作者项) */
const ICP = '{ICP 备案号待填}';
---

<footer class="sl-flex">
  <div class="meta sl-flex">
    <EditLink />
    <LastUpdated />
  </div>
  <Pagination />
  <div class="legal">
    <nav aria-label={t.nav} class="legal-links">
      {legal.map((l) => <a href={l.href} rel="noopener">{l.label}</a>)}
      <span class="icp">{ICP}</span>
    </nav>
    <p class="copyright">© {year} tansr · {t.copyright}</p>
  </div>
</footer>

<style>
  @layer starlight.core {
    footer {
      flex-direction: column;
      gap: 1.5rem;
    }
    .meta {
      gap: 0.75rem 3rem;
      justify-content: space-between;
      flex-wrap: wrap;
      margin-top: 3rem;
      font-size: var(--sl-text-sm);
      color: var(--sl-color-gray-3);
    }
    .meta > :global(p:only-child) {
      margin-inline-start: auto;
    }
    .legal {
      border-top: 1px solid var(--sl-color-gray-6);
      padding-top: 1rem;
      font-size: var(--sl-text-xs);
      color: var(--sl-color-gray-3);
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
    }
    .legal-links {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem 1.25rem;
      align-items: center;
    }
    .legal-links a {
      color: var(--sl-color-gray-2);
      text-decoration: none;
    }
    .legal-links a:hover {
      color: var(--sl-color-white);
      text-decoration: underline;
    }
    .copyright {
      margin: 0;
    }
  }
</style>
