    emailHint: '여기로 답변합니다. 단순 제보이고 답변이 필요 없으면 비워 두세요.',
    submit: '보내기',
    submitting: '보내는 중…',
    successTitle: '접수되었습니다.',
    successId: '티켓 ID',
    successNote: '업무 시간 내에 접수 순서대로 입력하신 이메일로 답변합니다.',
    errTitle: '지금은 제출할 수 없습니다.',
    errRate: '사용 중인 네트워크에서 최근 1시간 동안 제출이 너무 많았습니다. 잠시 후 다시 시도하거나 다음 주소로 이메일을 보내 주세요:',
    errUnavailable: '다음 주소로 이메일을 보내 주세요:',
    errTail: '— 링크에는 입력한 제목과 설명이 미리 채워져 있습니다.',
    noscript: '이 폼은 JavaScript가 필요합니다. 사용할 수 없으면 다음 주소로 이메일을 보내 주세요:',
    required: '필수 항목입니다.',
    tooLong: '길이 제한을 초과했습니다.',
    invalidEmail: '이메일 형식이 올바르지 않습니다.',
    hp: '웹사이트',
    period: '.',
  },
} as const;
const t = STRINGS[lang];
const mailto = `mailto:${SUPPORT_MAILBOX}`;
---

<form
  class="contact-form"
  data-contact-form
  data-contact-locale={lang}
  data-state="idle"
  data-cf-submitting={t.submitting}
  data-cf-msg-required={t.required}
  data-cf-msg-too-long={t.tooLong}
  data-cf-msg-invalid={t.invalidEmail}
  novalidate
>
  <fieldset>
    <legend>{t.legend}</legend>
    <p class="cf-intro">{t.intro}</p>

    <div class="cf-field">
      <label for="cf-subject">{t.subject}</label>
      <input id="cf-subject" name="subject" type="text" required maxlength={LIMITS.subject} autocomplete="off" aria-describedby="cf-subject-hint cf-subject-err" />
      <p id="cf-subject-hint" class="cf-hint">{t.subjectHint}</p>
      <p id="cf-subject-err" class="cf-err" data-cf-err="subject" hidden></p>
    </div>

    <div class="cf-field">
      <label for="cf-body">{t.body}</label>
      <textarea id="cf-body" name="body" required maxlength={LIMITS.body} rows="8" aria-describedby="cf-body-hint cf-body-err"></textarea>
      <p id="cf-body-hint" class="cf-hint">{t.bodyHint}</p>
      <p id="cf-body-err" class="cf-err" data-cf-err="body" hidden></p>
    </div>

    <div class="cf-field">
      <label for="cf-email">{t.email}</label>
      <input id="cf-email" name="email" type="email" maxlength={LIMITS.email} autocomplete="email" inputmode="email" aria-describedby="cf-email-hint cf-email-err" />
      <p id="cf-email-hint" class="cf-hint">{t.emailHint}</p>
      <p id="cf-email-err" class="cf-err" data-cf-err="email" hidden></p>
    </div>

    <!-- 蜜罐:人看不见、读屏跳过、Tab 不停;机器人填了即视为垃圾 -->
    <div class="cf-hp" aria-hidden="true">
      <label for="cf-website">{t.hp}</label>
      <input id="cf-website" name="website" type="text" tabindex="-1" autocomplete="off" />
    </div>

    <div class="cf-actions">
      <button type="submit" data-cf-submit>{t.submit}</button>
    </div>
  </fieldset>

  <div class="cf-status" role="status" aria-live="polite">
    <p class="cf-success" data-cf-success hidden>
      <strong>{t.successTitle}</strong>
      <span data-cf-ticket-wrap hidden>{t.successId} <code data-cf-ticket></code>{t.period}</span>
      <span>{t.successNote}</span>
    </p>
    <p class="cf-error" data-cf-error hidden>
      <strong>{t.errTitle}</strong>
      <span data-cf-err-rate hidden>{t.errRate}</span>
      <span data-cf-err-unavailable>{t.errUnavailable}</span>
      <a data-cf-mailto href={mailto}>{SUPPORT_MAILBOX}</a>
      <span>{t.errTail}</span>
    </p>
  </div>
  <noscript>
    <p class="cf-error">{t.noscript} <a href={mailto}>{SUPPORT_MAILBOX}</a>{t.period}</p>
  </noscript>
</form>

<script>
  import { API_BASE } from '../lib/api-base';
  import { failureKind, isHoneypotTripped, mailtoFallback, shouldFallback, ticketIdOf, ticketPayload, ticketsUrl, validateTicket } from '../lib/docs-api.mjs';

  const TIMEOUT_MS = 10000;

  type State = 'idle' | 'submitting' | 'success' | 'error';

  document.querySelectorAll<HTMLFormElement>('[data-contact-form]').forEach((form) => {
    const locale = form.dataset.contactLocale;
    const submit = form.querySelector<HTMLButtonElement>('[data-cf-submit]')!;
    const submitLabel = submit.textContent ?? '';
    // 文案由组件按语言渲染进 data-* 属性;脚本本身不分语言
    const submittingLabel = form.dataset.cfSubmitting ?? submitLabel;
    const success = form.querySelector<HTMLElement>('[data-cf-success]')!;
    const ticketWrap = form.querySelector<HTMLElement>('[data-cf-ticket-wrap]')!;
    const ticketEl = form.querySelector<HTMLElement>('[data-cf-ticket]')!;
    const error = form.querySelector<HTMLElement>('[data-cf-error]')!;
    const errRate = form.querySelector<HTMLElement>('[data-cf-err-rate]')!;
    const errUnavailable = form.querySelector<HTMLElement>('[data-cf-err-unavailable]')!;
    const mailto = form.querySelector<HTMLAnchorElement>('[data-cf-mailto]')!;
    const msgs = {
      required: form.dataset.cfMsgRequired ?? '',
      'too-long': form.dataset.cfMsgTooLong ?? '',
      invalid: form.dataset.cfMsgInvalid ?? '',
    };

    const fields = () => {
      const fd = new FormData(form);
      const s = (k: string) => String(fd.get(k) ?? '');
      return { subject: s('subject'), body: s('body'), email: s('email'), website: s('website') };
    };

    const setState = (state: State) => {
      form.dataset.state = state;
      const busy = state === 'submitting';
      submit.disabled = busy || state === 'success';
      submit.textContent = busy ? submittingLabel : submitLabel;
      form.setAttribute('aria-busy', String(busy));
      success.hidden = state !== 'success';
      error.hidden = state !== 'error';
    };

    const paintErrors = (errors: Record<string, 'required' | 'too-long' | 'invalid'>) => {
      form.querySelectorAll<HTMLElement>('[data-cf-err]').forEach((el) => {
        const code = errors[el.dataset.cfErr ?? ''];
        el.hidden = !code;
        el.textContent = code ? msgs[code] : '';
        const input = form.elements.namedItem(el.dataset.cfErr ?? '') as HTMLElement | null;
        input?.setAttribute('aria-invalid', String(Boolean(code)));
      });
    };

    const showError = (res: { status?: number } | null, f: { subject: string; body: string }) => {
      const kind = failureKind(res);
      errRate.hidden = kind !== 'rate-limited';
      errUnavailable.hidden = kind === 'rate-limited';
      mailto.href = mailtoFallback({ subject: f.subject, body: f.body });
      setState('error');
    };

    form.addEventListener('submit', async (ev) => {
      ev.preventDefault();
      if (form.dataset.state === 'submitting') return;
      const f = fields();
      const v = validateTicket(f);
      paintErrors(v.errors);
      if (!v.ok) {
        (form.querySelector<HTMLElement>('[aria-invalid="true"]') ?? submit).focus();
        return;
      }
      if (isHoneypotTripped(f.website)) {
        // 与服务端「非空即 202 假成功」同律:本地直接假成功,不发请求、不显编号
        ticketWrap.hidden = true;
        setState('success');
        return;
      }
      const payload = ticketPayload({ ...f, page: location.pathname, locale });
      if (!payload) return;
      setState('submitting');
      let res: Response | null = null;
      try {
        res = await fetch(ticketsUrl(API_BASE), {
          method: 'POST',
          mode: 'cors',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify(payload),
          signal: AbortSignal.timeout(TIMEOUT_MS),
        });
      } catch {
        console.debug('[tansr-docs] ticket not delivered (network)');
        showError(null, f);
        return;
      }
      if (shouldFallback(res)) {
        console.debug('[tansr-docs] ticket not delivered (status %d)', res.status);
        showError(res, f);
        return;
      }
      let ticketId: string | null = null;
      try {
        ticketId = ticketIdOf(await res.json());
      } catch {
        ticketId = null;
      }
      ticketWrap.hidden = ticketId === null;
      ticketEl.textContent = ticketId ?? '';
      setState('success');
    });
  });
</script>
