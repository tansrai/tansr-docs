    legend: 'Send us a message',
    intro: 'The form is delivered to our support mailbox as an email. No account required.',
    subject: 'Subject',
    subjectHint: 'e.g. "[CLI] tansr init says the PAT is invalid"',
    body: 'Details',
    bodyHint: 'Which product and version, the diagnostic output, the error code and message, how to reproduce. Never paste secrets.',
    email: 'Your email (optional)',
    emailHint: 'We reply here. Leave it empty if you only want to report something.',
    submit: 'Send',
    submitting: 'Sending…',
    successTitle: 'Received.',
    successId: 'Ticket',
    successNote: 'We reply to the email you left, in business hours, in the order received.',
    errTitle: 'We could not deliver the form right now.',
    errRate: 'Too many submissions from your network in the last hour. Please try again later, or email',
    errUnavailable: 'Please email',
    errTail: 'instead — your subject and details are pre-filled in the link.',
    noscript: 'The form needs JavaScript. Without it, please email',
    required: 'Required.',
    tooLong: 'Too long.',
    invalidEmail: 'That does not look like an email address.',
    hp: 'Website',
    period: '.',
  },
  ja: {
    legend: 'お問い合わせ',
    intro: 'フォームの内容はメールとしてサポート窓口に届きます。ログインは不要です。',
    subject: '件名',
    subjectHint: '例：「[CLI] tansr init で PAT が無効と表示される」',
    body: '問題の詳細',
    bodyHint: '形態とバージョン、診断出力、エラーコードと完全なメッセージ、再現手順。キーの値は絶対に貼らないでください。',
