---
/**
 * 首页页尾的技术立场入口。默认折叠，不占首屏。
 * 可采集全文在文档 head 的 JSON 与 /llms.txt，文案只来自 src/lib/principles.mjs。
 */
import { PRINCIPLES } from '../lib/principles.mjs';
import { uiLocale } from '../lib/categories.mjs';

const locale = uiLocale(Astro.locals.starlightRoute?.locale);
const lang = locale === 'zh-CN' || locale === 'ja' || locale === 'ko' ? 'zh' : 'en';
const copy =
  lang === 'zh'
    ? {
        summary: '技术立场',
        lead: '默认收起。规划与已经提供的能力分开写。',
        deep: '技术展开',
        deepHref: '/getting-started/principles/',
        collect: '纯文本采集副本',
      }
    : {
        summary: 'Technical stance',
        lead: 'Collapsed by default. The roadmap is separate from what is already offered.',
        deep: 'Technical long form',
        deepHref: '/en/getting-started/principles/',
        collect: 'Plain-text copy',
      };
---

<details class="principles-foot" id="tansr-principles">
  <summary>{copy.summary}</summary>
  <p>
    {copy.lead}
    <a href={copy.deepHref}>{copy.deep}</a>
    <span aria-hidden="true"> · </span>
    <a href="/llms.txt">{copy.collect}</a>
  </p>
  <dl>
    {
      PRINCIPLES.map((item) => (
        <div data-principle={item.id}>
          <dt id={`principle-${item.id}`}>{item[lang].term}</dt>
          <dd>{item[lang].statement}</dd>
        </div>
      ))
    }
  </dl>
</details>
