---
/**
 * 首页 hero 里的大搜索入口:点击把焦点交给顶栏里的搜索框,就地输入(同一索引)。
 * 搜索框尚未就绪时,退而把焦点交给顶栏按钮。
 */
import { Icon } from '@astrojs/starlight/components';
import { uiLocale } from '../lib/categories.mjs';

interface Props {
  placeholder?: string;
}
const PLACEHOLDER = {
  'zh-CN': '搜索文档与帮助中心:错误码、命令、环境变量、问题关键词…',
  en: 'Search docs and help center…',
  ja: 'ドキュメントとヘルプセンターを検索…',
  ko: '문서와 도움말 센터 검색…',
} as const;
const placeholder = Astro.props.placeholder ?? PLACEHOLDER[uiLocale(Astro.locals.starlightRoute.locale)];
---

{/* 可访问名 = 可见文字(placeholder);不另设 aria-label,否则 Lighthouse label-content-name-mismatch 红(DS-21) */}
<button type="button" class="hero-search" data-hero-search>
  <Icon name="magnifier" size="1.25rem" />
  <span class="hero-search-text">{placeholder}</span>
  <kbd class="sl-hidden md:sl-flex" aria-hidden="true"><kbd>Ctrl</kbd><kbd>K</kbd></kbd>
</button>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-hero-search]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const input = document.querySelector<HTMLInputElement>('site-search input');
      if (input) {
        input.focus();
        return;
      }
      document.querySelector<HTMLButtonElement>('site-search button[data-open-modal]')?.focus();
    });
  });
</script>
