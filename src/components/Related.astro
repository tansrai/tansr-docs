---
/**
 * 文章页尾「相关文章」:读 frontmatter `related`(站内 slug 列表)渲染链接。
 * slug 在当前语言与根语言都不存在 → 构建期抛(死链不进 dist)。无 related 不渲染。
 */
import { localeEntries, slugToHref } from '../lib/resolve';
import { uiLocale } from '../lib/categories.mjs';

const { entry, locale } = Astro.locals.starlightRoute;
const related = entry.data.related ?? [];
/** 标题与「该文尚无本语言版本、链到中文原文」的角标 */
const STRINGS = {
  'zh-CN': { title: '相关文章', fallback: '中文' },
  en: { title: 'Related articles', fallback: 'zh-CN' },
  ja: { title: '関連記事', fallback: '中国語' },
  ko: { title: '관련 문서', fallback: '중국어' },
} as const;
const t = STRINGS[uiLocale(locale)];

const current = await localeEntries(locale);
const root = locale ? await localeEntries(undefined) : current;

const items = related.map((slug) => {
  const hit = current.find((e) => e.id === slug);
  const fallback = hit ?? root.find((e) => e.id === slug);
  if (!fallback) {
    throw new Error(
      `[Related] ${entry.id}: related slug "${slug}" 不存在于 src/content/docs(当前语言与根语言均无)。请修正 slug 或先写该文。`,
    );
  }
  return {
    href: slugToHref(hit ? locale : undefined, slug),
    title: fallback.entry.data.title,
    fallback: !hit && Boolean(locale),
  };
});
---

{
  items.length > 0 && (
    <section class="related" aria-labelledby="related-title">
      <h2 id="related-title">{t.title}</h2>
      <ul>
        {items.map((it) => (
          <li>
            <a href={it.href}>{it.title}</a>
            {it.fallback && <span class="category-badge">{t.fallback}</span>}
          </li>
        ))}
      </ul>
    </section>
  )
}
